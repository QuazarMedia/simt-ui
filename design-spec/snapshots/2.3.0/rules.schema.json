{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simt.space/cosmos/design/rules.schema.json",
  "title": "Cosmos rules",
  "description": "Every normative Cosmos rule with its acceptance criterion, grouped by platform section.",
  "type": "object",
  "required": ["version", "updated", "status", "ruleCount", "sections"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "format": "date" },
    "status": { "const": "Normative specification" },
    "normativeLanguage": { "type": "object" },
    "ruleCount": { "type": "integer", "minimum": 1 },
    "platform": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {
          "enum": ["web-page", "web-app", "mobile-app", "watch-app"]
        },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "platform", "url", "rules"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "platform": {
            "enum": ["common", "web-page", "web-app", "mobile-app", "watch-app"]
          },
          "table": { "type": "object" },
          "tables": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object" }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "level", "requirement", "acceptance"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[CPAMW][0-9]{2}$"
                },
                "title": { "type": "string", "minLength": 1 },
                "level": {
                  "enum": ["must", "should", "may"]
                },
                "requirement": { "type": "string", "minLength": 1 },
                "acceptance": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    }
  },
