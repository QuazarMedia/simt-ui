          "app.simt.cosmos": { "hex": "#000000" }
        }
      },
      "surface": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 1
        },
        "$extensions": {
          "app.simt.cosmos": { "hex": "#000000" }
        }
      },
      "text": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7333333333333333, 0.6823529411764706, 0.7333333333333333],
          "alpha": 1
        },
        "$extensions": {
          "app.simt.cosmos": { "hex": "#BBAEBB" }
        }
      },
      "faint": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6039215686274509, 0.5450980392156862, 0.6039215686274509],
          "alpha": 1
        },
        "$extensions": {
          "app.simt.cosmos": { "hex": "#9A8B9A" }
        }
      },
      "line": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7333333333333333, 0.6823529411764706, 0.7333333333333333],
          "alpha": 0.16
        },
        "$extensions": {
          "app.simt.cosmos": { "css": "rgb(187 174 187 / 0.16)" }
        }
      },
      "bearing": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.7803921568627451, 0.4],
          "alpha": 1
        },
        "$extensions": {
          "app.simt.cosmos": { "hex": "#FFC766" }
        }
      }
    }
  },
  "platformAdapters": {
    "$description": "Radius, duration and easing per platform part, with the notation each part authors in and the geometry a native shape replaces. Spacing needs no mapping: 1 unit is 1 CSS px on web and 1 dp natively (C09).",
    "watch": {
      "$description": "Wear OS round screens. There is no corner to measure on a round screen, so this part publishes shapes rather than a radius: control and record are round and an overlay is a capsule. The easing and duration sets are the Android ones by decision — the same scale at a much smaller physical size.",
      "$extensions": {
        "app.simt.cosmos": {
          "colorSpace": "srgb",
          "radius": { "control": "round", "record": "round", "overlay": "capsule" }
        }
      },
      "duration": {
        "feedback": {
          "$type": "duration",
          "$value": { "value": 150, "unit": "ms" }
        },
        "state": {
          "$type": "duration",
          "$value": { "value": 300, "unit": "ms" }
        },
        "context": {
          "$type": "duration",
          "$value": { "value": 500, "unit": "ms" }
        }
      },
      "easing": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.2, 0, 0.2, 1]
        },
        "enter": {
          "$type": "cubicBezier",
          "$value": [0.05, 0.7, 0.1, 1]
        },
        "exit": {
          "$type": "cubicBezier",
          "$value": [0.3, 0, 0.8, 0.15]
        },
        "transform": {
          "$type": "cubicBezier",
          "$value": [0.2, 0, 0, 1]
        }
      }
    }
  },
  "contrastPairs": {
    "$ref": "https://simt.space/cosmos/design/contrast-pairs.json",
    "fetchWhen": ["introducing a colour or gradient", "pairing a translucent, blurred or layered surface", "checking or changing a theme profile"],
    "$description": "Measured composited contrast per theme profile, with the guidance for each pair."
  },
  "motionMotifs": {
    "$ref": "https://simt.space/cosmos/design/motion.json",
    "fetchWhen": [
      "animating a state change, on any platform",
      "choosing between the tiers, or deciding whether a change animates at all",
      "porting a transition to a native toolkit and proving curve parity"
    ],
    "$description": "The named choreographies a state change animates with, per tier and per platform, with the curve parity fixture."
  },
  "components": {
    "$ref": "https://simt.space/cosmos/design/components.json",
    "fetchWhen": [
      "building or changing any surface, before choosing a pattern",
      "deciding which rules a component inherits and therefore which it must satisfy",
      "porting a component to a native toolkit and finding the counterpart that exists"
    ],
    "$description": "The component index: which rules each component inherits, the theme roles and corner role it consumes, the states it can be in and the motif it moves with, sliced per platform part."
  },
  "$extensions": {
    "app.simt.cosmos": {
      "document": { "version": "2.3.0", "updated": "2026-10-03", "status": "Normative specification" },
      "part": { "id": "watch-app", "label": "Watch app", "adapter": "watch" },
      "scope": {
        "profiles": ["deepSpace", "watchAmbient"],
        "stars": false,
        "gradients": ["corona", "rim", "action"],
        "colorSpace": "srgb",
        "starfield": false
      }
    },
    "version": "2.3.0",
    "defaultProfile": "deepSpace",
    "profiles": ["deepSpace", "daylight", "astronomy", "watchAmbient"],
    "cssThemeAttribute": "data-cosmos-theme",
    "cssRolePrefix": "--cosmos-",
    "pairRatioField": "$value",
    "pairGuidanceField": "$extensions.app.simt.cosmos"
  }
}
