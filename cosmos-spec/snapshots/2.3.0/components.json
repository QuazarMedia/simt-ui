{
  "$description": "Cosmos 2.3.0 component index: for every component the rules it inherits, the theme roles, layer and corner role it consumes, the states it can be in, the motif that animates it and the counterpart that already exists in each product. References only — every treatment stays in the rules the entries name. Sliced by platform part under parts.",
  "version": "2.3.0",
  "updated": "2026-10-03",
  "status": "Normative specification",
  "fetchWhen": [
    "building or changing any surface, before choosing a pattern",
    "deciding which rules a component inherits and therefore which it must satisfy",
    "porting a component to a native toolkit and finding the counterpart that exists"
  ],
  "referencesOnly": true,
  "roles": {
    "theme": [
      "background",
      "surface",
      "raised",
      "highest",
      "text",
      "muted",
      "faint",
      "line",
      "action",
      "accentText",
      "onAction",
      "social",
      "identity",
      "precision",
      "live",
      "outdoors",
      "danger",
      "success",
      "focus",
      "boundary"
    ],
    "layer": ["field", "chrome", "context", "scrim", "modal", "feedback", "skip"],
    "radius": ["control", "record", "overlay", "secondary", "emphasis", "circle"]
  },
  "states": {
    "default": {
      "rules": ["C12"]
    },
    "hover": {
      "rules": ["C12"]
    },
    "pressed": {
      "rules": ["C12"]
    },
    "focus": {
      "rules": ["C12", "C19"]
    },
    "pending": {
      "rules": ["C12"]
    },
    "disabled": {
      "rules": ["C12"]
    },
    "error": {
      "rules": ["C13", "C16"]
    },
    "confirmed": {
      "rules": ["C12"]
    },
    "selected": {
      "rules": ["C12", "C14"]
    },
    "stale": {
      "rules": ["C16"]
    },
    "offline": {
      "rules": ["C16"]
    }
  },
  "notApplicable": {
    "notInteractive": { "why": "The component has no hover or press affordance of its own; whatever the pointer is really addressing is the control inside or behind it." },
    "notFocusable": { "why": "Nothing of it takes focus. What takes focus is the control it hosts or the surface it reports into." },
    "notAsync": { "why": "The component is already on screen with its final reading, so there is no state between the request and the answer." },
    "alwaysAvailable": { "why": "There is nothing to disable. It carries no action to withhold, so a disabled variant would be a decoration." },
    "noFailureMode": { "why": "It cannot fail on its own. Anything that can goes through the banner, the toast or the dialog that owns the failure." },
    "confirmedElsewhere": { "why": "Confirmation is a separate dialog, so the component itself has no settled confirmed state to draw." },
    "notSelectable": { "why": "There is no selected and unselected condition. Choosing it is an action or a dialog, not a mode it holds." },
    "notFetched": { "why": "It shows no remote data, so it cannot be out of date. Whatever is stale about it is stale about a record or a list." },
    "notNetworkBound": { "why": "It does not depend on a connection, so it cannot be offline. What can be offline is the screen carrying it." }
  },
