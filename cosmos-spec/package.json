{
  "name": "simt-cosmos-private-snapshot",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Pinned private-development Cosmos snapshot; public redistribution blocked",
  "scripts": {
    "check": "node scripts/check.js integrity && node --test tests/snapshot.test.js",
    "check:integrity": "node scripts/check.js integrity",
    "check:canonical-schema": "node scripts/check.js canonical-schema",
    "test": "node --test tests/snapshot.test.js",
    "archive:private": "node scripts/check.js archive"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
