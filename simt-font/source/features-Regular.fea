languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem arab dflt;
languagesystem arab URD;
languagesystem arab FAR;
@K_T = [T];
@K_V = [V W];
@K_Y = [Y];
@K_A = [A Agrave Aacute Acircumflex Atilde Adieresis Aring];
@K_L = [L];
@K_F = [F P];
@K_lc_round = [a c d e g o q s agrave aacute acircumflex atilde adieresis aring egrave eacute ecircumflex edieresis ograve oacute ocircumflex otilde odieresis ccedilla oe ae];
@K_lc_vy = [v w y];
@K_lc_rn = [m n p r u];
@K_punct = [period comma];
@K_O = [O C G Q];
feature kern {
  script latn;
  pos @K_T @K_lc_round -70;
  pos @K_T @K_lc_rn -50;
  pos @K_T @K_A -55;
  pos @K_T @K_punct -80;
  pos @K_V @K_lc_round -45;
  pos @K_V @K_A -45;
  pos @K_V @K_punct -70;
  pos @K_Y @K_lc_round -70;
  pos @K_Y @K_A -55;
  pos @K_Y @K_punct -80;
  pos @K_A @K_T -55;
  pos @K_A @K_V -45;
  pos @K_A @K_Y -55;
  pos @K_A @K_lc_vy -25;
  pos @K_L @K_T -70;
  pos @K_L @K_V -60;
  pos @K_L @K_Y -70;
  pos @K_F @K_punct -80;
  pos @K_F @K_A -35;
  pos @K_lc_vy @K_punct -50;
  pos @K_O @K_punct -15;
} kern;
