{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simt-cosmos",
  "compatibility_date": "2026-10-03",
  // Static assets only. Clean canonical routes are explicit 200 rewrites in
  // dist/_redirects, and unknown requests receive the generated 404 page.
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "cosmos.simt.app",
      "zone_name": "simt.app",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": false,
    },
    "issues": { "enabled": true },
  },
}
